<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" xmlns:c="c" xmlns:graphql="graphql" xmlns:meta-gen="meta-gen" xmlns:biz="biz"
      displayName="车辆通行记录信息表" xmlns:ui="ui" xmlns:orm="orm">

    <entityName>com.fliad.hikvision.dao.entity.VehicleTrafficRecord</entityName>

    <primaryKey>id_</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys/>

    <props>
        <prop name="id_" displayName="主键" propId="1" mandatory="true" queryable="true" sortable="true" insertable="true"
              updatable="false">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="kkbh" displayName="卡口编号，符合GA/T 16.31与GA/T 543.10要求" propId="2" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="fxlx" displayName="方向类型" propId="3" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="cdh" displayName="车道号" propId="4" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="10"/>
        </prop>
        <prop name="gcsj" displayName="过车时间，格式yyyy-mm-dd hh24:mi:ss" propId="5" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.time.LocalDateTime"/>
        </prop>
        <prop name="wfdm" displayName="违法行为，符合GA/T 16.31与GA/T 543.5要求" propId="6" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="hphm" displayName="号牌号码，符合GA/T 543.5要求，无牌等用&quot;-&quot;表示" propId="7" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="hpzl" displayName="号牌种类，符合GA/T 16.7与GA/T 543.5要求：01-大型汽车,02-小型汽车,...,99-其他号牌" propId="8"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="2"/>
        </prop>
        <prop name="hpys" displayName="号牌颜色，符合GB 1.1-2009：0-白色,1-黄色,2-蓝色,3-黑色,4-绿色,5-未识别,9-其他颜色" propId="9"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Byte"/>
        </prop>
        <prop name="fzhphm" displayName="辅助号牌号码，无牌等用&quot;-&quot;表示" propId="10" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="fzhpzl" displayName="辅助号牌种类，符合GA/T 16.7与GA/T 543.5要求" propId="11" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="2"/>
        </prop>
        <prop name="fzhpys" displayName="辅助号牌颜色：0-白色,1-黄色,2-蓝色,3-黑色,4-绿色,5-未识别,9-其他颜色" propId="12" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Byte"/>
        </prop>
        <prop name="cllx" displayName="车辆类型，符合GA/T 16.4与GA/T 543.5要求" propId="13" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="cwkc" displayName="车外廓长，单位厘米，最长5位" propId="14" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="5"/>
        </prop>
        <prop name="clpp" displayName="车辆品牌，符合GA/T 543.10要求" propId="15" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="csys" displayName="车身颜色，符合GA/T 16.8与GA/T 543.5：A-白,B-灰,C-黄,D-粉,E-红,F-紫,G-绿,H-蓝,I-棕,J-黑" propId="16"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="2"/>
        </prop>
        <prop name="hpkxd" displayName="号牌识别可信度，0~100%" propId="17" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.Byte"/>
        </prop>
        <prop name="mwhpkxd" displayName="每位号牌识别可信度，格式如&quot;苏-80,B-90,...&quot;" propId="18" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="200"/>
        </prop>
        <prop name="cxkxd" displayName="车型识别可信度，0~100%" propId="19" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.Byte"/>
        </prop>
        <prop name="ppkxd" displayName="品牌识别可信度，0~100%" propId="20" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.Byte"/>
        </prop>
        <prop name="xwtz" displayName="行为特征，1-不系安全带;2-拨打电话;...多个用分号分隔" propId="21" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="tplj" displayName="图片路径" propId="22" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="255"/>
        </prop>
        <prop name="tp1" displayName="通行图片1" propId="23" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="255"/>
        </prop>
        <prop name="tp2" displayName="通行图片2" propId="24" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="255"/>
        </prop>
        <prop name="tp3" displayName="通行图片3" propId="25" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="255"/>
        </prop>
        <prop name="tztp" displayName="特征图片" propId="26" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="255"/>
        </prop>
        <prop name="jsrtp" displayName="驾驶人图片" propId="27" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="255"/>
        </prop>
        <prop name="clsd" displayName="车辆速度，单位km/h" propId="28" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="tid" displayName="rfid标签芯片识别号" propId="29" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="zkrs" displayName="载客人数" propId="30" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="cid" displayName="rfid标识卡号码" propId="31" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="sxjbh" displayName="摄像机设备编号" propId="32" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
    </props>
</meta>