        <prop name="nextNodeType" displayName="下一个节点类型（0开始节点 1中间节点 2结束节点 3互斥网关 4并行网关）" propId="6" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Boolean"/>
        </prop>
        <prop name="skipName" displayName="跳转名称" propId="7" queryable="true" sortable="true" insertable="true"
