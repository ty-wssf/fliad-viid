            <schema type="java.lang.Long"/>
        </prop>
        <prop name="type" displayName="人员类型（1待办任务的审批人权限 2待办任务的转办人权限 3待办任务的委托人权限）" propId="2" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="1"/>
        </prop>
        <prop name="processedBy" displayName="权限人" propId="3" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="80"/>
        </prop>
        <prop name="associated" displayName="任务表id" propId="4" mandatory="true" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.Long"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="5" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.time.LocalDateTime"/>
        </prop>
        <prop name="createBy" displayName="创建人" propId="6" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="80"/>
        </prop>
        <prop name="updateTime" displayName="更新时间" propId="7" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.time.LocalDateTime"/>
        </prop>
        <prop name="updateBy" displayName="创建人" propId="8" queryable="true" sortable="true" insertable="true"
