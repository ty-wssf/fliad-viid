<?xml version="1.0" encoding="UTF-8" ?>

<imp x:schema="/nop/schema/excel/imp.xdef" xmlns:x="/nop/schema/xdsl.xdef"
     templatePath="hikvision.template.xlsx">
    <sheets>
        <sheet name="海康设备" field="devices" list="true">
            <fields>
                <field name="deviceId" displayName="设备编号" mandatory="true">
                    <schema stdDomain="string"/>
                </field>

                <field name="name" displayName="设备名称" mandatory="true">
                    <schema stdDomain="string"/>
                </field>

                <field name="ipAddr" displayName="IP地址" mandatory="true">
                    <schema stdDomain="string"/>
                </field>

                <field name="port" displayName="端口" mandatory="true">
                    <schema stdDomain="int"/>
                </field>

                <field name="username" displayName="用户名" mandatory="true">
                    <schema stdDomain="string"/>
                </field>

                <field name="password" displayName="密码" mandatory="true">
                    <schema stdDomain="string"/>
                </field>

                <field name="enableStatus" displayName="启用状态" mandatory="true" importDictLabel="true">
                    <schema stdDomain="int" dict="hikvision/enableStatus">
                        <validator>
                            <c:script><![CDATA[
                                import io.nop.api.core.exceptions.NopException;
                                import io.nop.excel.ExcelErrors;
                                import org.slf4j.LoggerFactory;

                                if(value != 0 && value != 1) {
                                    LOG.error("enableStatus验证失败,值为: {}", value);
                                    throw new NopException(ExcelErrors.ERR_IMPORT_FIELD_VALUE_VALIDATE_FAIL)
                                        .param("errorDesc", "启用状态必须为0(禁用)或1(启用),当前输入值:" + value);
                                }
                            ]]></c:script>
                        </validator>
                    </schema>
                </field>
            </fields>
        </sheet>
    </sheets>
</imp>
