            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="applicantorg" displayName="申请单位" propId="6" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="begintime" displayName="开始时间" propId="7" queryable="true" sortable="true" insertable="true"
              updatable="true">
            <schema type="java.lang.String" precision="15"/>
        </prop>
        <prop name="endtime" displayName="结束时间" propId="8" queryable="true" sortable="true" insertable="true"
